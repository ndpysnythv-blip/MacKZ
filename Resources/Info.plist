<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>MacKZ</string>
    <key>CFBundleDisplayName</key>
    <string>MacKZ</string>
    <key>CFBundleExecutable</key>
    <string>MacKZ</string>
    <key>CFBundleIdentifier</key>
    <string>com.mackz.plugin</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.10.1</string>
    <key>CFBundleVersion</key>
    <string>44</string>
    <!-- 应用图标：由 build.sh 用 Resources/logo.jpg 自动生成 AppIcon.icns（作者 KDXZHX 的 logo） -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 KDXZHX · MacKZ</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- 无 Dock 图标、不抢占前台：符合“不干扰系统操作”的要求 -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <!-- 手机遥控 / 手机陀螺仪：Mac 上会开启一个只监听局域网的本地服务，供手机浏览器连接 -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>MacKZ 会在局域网内开启一个本地服务，供手机浏览器打开遥控页面、并接收手机陀螺仪的姿态数据来模拟 MacBook 铰链开合角度。数据只在本机与手机之间传输，不会上传到任何服务器。</string>
</dict>
</plist>
